rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.uid == 'qu5wM0hwTlMi0JtbfJtBYSXUx6l2';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isOwner();
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.status == 'pendente'
        && request.resource.data.customer is map
        && request.resource.data.items is list
        && request.resource.data.totalAmount is number;
      allow read, update, delete: if isOwner();
    }
  }
}
